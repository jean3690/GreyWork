# GreyWork headless 服务端 —— 环境变量示例。
#
# 用法：cp .env.example .env，按需填写；docker compose 会自动读取 .env。
# 全部变量都可选，但**至少给一种密码来源**，否则首启会生成随机密码并只打印一次
# （docker compose logs greywork 可取）。

# ── 密码策略（优先级：HASH > <data_dir>/auth.json > 明文）────────────────────
# ① 推荐：argon2 PHC 串，明文不出现在任何地方。
#    生成：docker compose run --rm greywork hash-password
GREYWORK_PASSWORD_HASH=
# ② 或写入卷内的 auth.json（0600），同样不留明文在 compose 文件里。
#    执行：docker compose run --rm greywork set-password
# ③ 最简但不推荐：明文进 compose/环境变量，`docker inspect` 可见。
#    需要时自行在 docker-compose.yml 里加 GREYWORK_PASSWORD。

# ── 授权面 ──────────────────────────────────────────────────────────────────
# 预授权工作区根（**容器内**路径，冒号分隔）：只有列出的目录允许 fs_* / git_* 访问。
# 记得同时在 docker-compose.yml 的 volumes 里把宿主目录挂进来。
GREYWORK_WORKSPACE_ROOTS=
# 额外放行的 agent 程序（逗号分隔，与内置白名单取并集）。派生镜像里装了 agent CLI 时用。
GREYWORK_AGENT_PROGRAMS=

# ── 安全 ────────────────────────────────────────────────────────────────────
# 置于 TLS 反代（Caddy / nginx / Traefik）之后时设 1：cookie 带 Secure，并开始发 HSTS。
# 纯 HTTP 内网部署保持 0（下发 HSTS 无意义，还可能把用户锁在外面）。
GREYWORK_SECURE_COOKIE=0
# 允许被 iframe 内嵌的云端 Office 域名（逗号分隔，如 https://docs.example.com）。
# 只接受 scheme://host[:port]；非法项会被丢弃并在启动日志里点名。
GREYWORK_FRAME_ORIGINS=

# ── 定时任务 ────────────────────────────────────────────────────────────────
# 设 1 → 本容器是定时任务的**主执行者**：到点即跑，不需要浏览器或自己的电脑一直开着。
# 默认 0（与桌面端一致，只在渲染端缺席 2 分钟后兜底认领）。
GREYWORK_AUTOMATION_HOST_PRIMARY=0

# ── 无人值守执行所需的模型凭证 ───────────────────────────────────────────────
# 变量名要与设置里各供应商的 apiKeyEnv 一致（默认见设置页）。不注入则任务会以
# 「无可用模型配置」失败。按实际使用情况取消注释：
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
