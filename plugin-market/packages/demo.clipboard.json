{
  "schemaVersion": 1,
  "manifest": {
    "id": "demo.clipboard",
    "name": "剪贴板工具",
    "version": "1.0.0",
    "description": "clipboard 能力演示：把输入框内容写进系统剪贴板，或读回当前剪贴板文本（读需显式声明 ops）。",
    "kind": "worker",
    "runtime": {
      "type": "worker",
      "entry": "https://raw.githubusercontent.com/jean3690/greywork-plugin-market/6b5a17f54305dfbe8a84c7ac4470765bcaf1fe02/packages/demo.clipboard.js",
      "sha256": "7c52c48b46d49078be896954f520e6e8800529b19226ccd50fc63c9f27f1013f"
    },
    "requires": [
      {
        "capability": "clipboard",
        "ops": ["read", "write"]
      }
    ],
    "contributes": {
      "modes": [
        {
          "id": "demo-clipboard",
          "title": "剪贴板工具",
          "icon": "copy",
          "page": {
            "eyebrow": "Marketplace plugin · clipboard",
            "heading": "剪贴板工具",
            "body": "clipboard 是唯一「读写默认不对称」的能力：字符串形态只给 write，读必须在 manifest 里声明 ops: [\"read\"]。宿主按运行时选可靠路径（Electron 主进程 / 浏览器 Web API）；单次上限 64 KiB，每插件 1 分钟最多 20 次；审计只记长度，剪贴板内容不会落日志。浏览器态读取可能需要用户手势，被拒时按普通错误上抛。",
            "fields": [
              {
                "key": "text",
                "label": "要复制的内容",
                "kind": "text",
                "default": "Hello from a plugin",
                "maxLength": 4096
              },
              {
                "key": "pasted",
                "label": "读回的剪贴板",
                "kind": "text",
                "default": "",
                "maxLength": 4096
              },
              {
                "key": "status",
                "label": "最近动作",
                "kind": "text",
                "default": "尚未操作",
                "maxLength": 120
              }
            ],
            "outputs": [
              {
                "label": "剪贴板",
                "valueKey": "pasted"
              },
              {
                "label": "动作",
                "valueKey": "status"
              }
            ],
            "actions": [
              {
                "id": "copy",
                "label": "写入剪贴板",
                "style": "primary",
                "operation": {
                  "type": "invoke",
                  "handler": "copy"
                }
              },
              {
                "id": "paste",
                "label": "读回剪贴板",
                "style": "secondary",
                "operation": {
                  "type": "invoke",
                  "handler": "paste"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
