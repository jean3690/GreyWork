# back/grey（Java 控制面）环境变量示例。
#
# 用法：
#   cp .env.example .env && set -a && . ./.env && set +a
#   ./mvnw spring-boot:run
#
# 本地开发时 spring-boot-docker-compose 会自动起 compose.yaml 里的 MySQL / Redis / RustFS，
# 并把连接信息注入进程，所以下面「数据源」一段只在独立部署（jar / 外部库）时才需要。

# ── 服务 ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
# 控制面自己的对外地址：生成通道 webhook 回调地址时用
GREY_PUBLIC_BASE_URL=http://localhost:8080

# ── 运维台 / 认证 ───────────────────────────────────────────────────────────
# 管理员邮箱名单（逗号分隔）。命中者在登录时获得 admin 角色，启动时也会对已有账号对齐。
GREY_ADMIN_EMAILS=admin@example.com
# 运维台初始密码：首次启动为该邮箱建号并写入 bcrypt。留空则随机生成并打印到启动日志。
GREY_ADMIN_PASSWORD=
# 普通客户端首次登录用的一次性码；留空则每次启动随机生成并打印。
GREY_ENROLL_CODE=
# 入场码连续失败上限 / 窗口；密码登录失败与它分开计数。
GREY_ENROLL_MAX_FAILURES=10
# 每用户设备数上限（超出淘汰最久没出现的设备并吊销会话）。
GREY_MAX_DEVICES=20
# OIDC 登录成功后允许跳回的客户端前缀（逗号分隔）。
GREY_OIDC_REDIRECTS=http://127.0.0.1,http://localhost,greywork://

# ── 数据源（独立部署时）────────────────────────────────────────────────────
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/grey?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# SPRING_DATASOURCE_USERNAME=grey
# SPRING_DATASOURCE_PASSWORD=change-me
# SPRING_DATA_REDIS_HOST=127.0.0.1
# SPRING_DATA_REDIS_PORT=6379

# ── 模型网关 ────────────────────────────────────────────────────────────────
# 32 字节 base64，生成：openssl rand -base64 32。用于加密用户上传的供应商 key。
# 不配置则 llm_key 相关接口启动后不可用。
GREY_MASTER_KEY=
GREY_LLM_RPM=60
# 0 表示不限额
GREY_LLM_DAILY_TOKENS=0
GREY_AI_DEFAULT_MODEL=
GREY_AI_MAX_TOKENS=2048
GREY_AI_TEMPERATURE=0.2

# ── 自动化 ──────────────────────────────────────────────────────────────────
GREY_AUTOMATION_TICK_MS=30000
GREY_AUTOMATION_CLAIM_LEASE=PT30M
GREY_AUTOMATION_CLOUD_CONCURRENCY=4
GREY_AUTOMATION_RETENTION_DAYS=30
# 留空 = 服务器默认时区
GREY_AUTOMATION_ZONE=

# ── 对象存储（S3 兼容；未启用时上传接口回 storage_disabled）──────────────────
GREY_S3_ENABLED=false
GREY_S3_ENDPOINT=http://127.0.0.1:9000
GREY_S3_REGION=us-east-1
GREY_S3_ACCESS_KEY=
GREY_S3_SECRET_KEY=
GREY_S3_BUCKET=greywork
GREY_S3_PATH_STYLE=true
GREY_S3_PRESIGN_TTL=PT15M
GREY_S3_MAX_OBJECT_BYTES=524288000
GREY_S3_PUBLIC_BASE_URL=
GREY_S3_PENDING_TTL=PT24H

# ── CORS ────────────────────────────────────────────────────────────────────
# 只有「前端与后端不同源」时才需要（例如把运维台单独部署）。本地 dev 走 Vite 代理，不用配。
GREY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
