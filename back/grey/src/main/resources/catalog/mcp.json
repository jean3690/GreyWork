      "version": "0.1.0",
      "repository": {
        "url": "https://github.com/modelcontextprotocol/servers"
      },
      "packages": [
        {
          "registryType": "npm",
          "identifier": "@modelcontextprotocol/server-memory",
          "version": "latest",
          "environmentVariables": [
            {
              "name": "MEMORY_FILE_PATH"
            }
          ]
        }
      ],
      "remotes": []
    },
    {
      "name": "io.greywork/fetch",
      "title": "网页抓取",
