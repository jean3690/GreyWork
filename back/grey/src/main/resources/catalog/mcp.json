      "version": "0.1.0",
      "repository": {
        "url": "https://github.com/modelcontextprotocol/servers"
      },
      "packages": [
        {
          "registryType": "pypi",
          "identifier": "mcp-server-fetch",
          "version": "latest",
          "environmentVariables": []
        }
      ],
      "remotes": []
    }
  ]
}
