node_modules/
dist/
apps/desktop/src-tauri/target/
.playwright*
.agents/
AGENTS.md
AGENT.md
*.log
# 日志轮转目录：*.log 盖不住同目录的 .<hash>-audit.json（winston-daily-rotate-file 的轮转元数据）
logs/
# WSL 从 Windows 拷文件时留下的 NTFS 备用数据流（<文件名>:Zone.Identifier），与源码无关
*:Zone.Identifier
# 例外：应用图标是构建输入（tauri.conf.json 的 bundle.icon 直接引用），
# 被 *.png 挡住的话新克隆的仓库压根构建不起来。
!apps/desktop/src-tauri/icons/*.png
.env
.env.*
!.env.example
.pnpm-store/
greyWork*.png
.omo/
coverage/

# 产物渲染自测生成的样本文件（docx/pptx 预览联调输出，非源码）
sample-preview.docx

# 本地开发链接：greyAgent 为独立仓库，软链接引用其实时源码（不纳入版本库）
/greyAgent

# 插件市场签名私钥（ed25519）：公钥硬编码在宿主 plugin_market.rs，私钥永不入库
plugin-market/.signing-key*
plugin-market/.signing-key.pem
