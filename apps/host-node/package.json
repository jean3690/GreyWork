{
  "name": "@greywork/host-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node implementation of the GreyWork headless host (migration target for apps/server).",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@wechatbot/wechatbot": "^2.2.0",
    "hash-wasm": "^4.12.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "typescript": "~5.6.2",
    "vitest": "^5.0.5"
  }
}
