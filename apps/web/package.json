{
  "name": "@greywork/web",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && cross-env NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project node",
    "test:dom": "vitest run --project dom",
    "e2e": "node e2e/smoke.e2e.mjs"
  },
  "dependencies": {
    "@greywork/host-ipc": "workspace:*",
    "@greywork/workbench": "workspace:*",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@greywork/vite-config": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
