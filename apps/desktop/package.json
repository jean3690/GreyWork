{
  "name": "@greywork/desktop",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && cross-env NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:wayland": "cross-env GDK_BACKEND=wayland WAYLAND_DISPLAY=wayland-0 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project node",
    "test:dom": "vitest run --project dom",
    "e2e": "node e2e/smoke.e2e.mjs",
    "e2e:login": "node e2e/login-gate.e2e.mjs",
    "e2e:served": "node e2e/served-spa.e2e.mjs"
  },
  "dependencies": {
    "@greywork/host-ipc": "workspace:*",
    "@greywork/workbench": "workspace:*",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.12.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
