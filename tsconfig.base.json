{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "cesium/Build/Cesium/Widgets/widgets.css": ["./packages/spatial/src/cesium-css.d.ts"],
      "maplibre-gl/dist/maplibre-gl.css": ["./packages/gis/src/maplibre-css.d.ts"]
    }
  }
}
